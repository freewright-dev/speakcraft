#!/usr/bin/env bash
set -euo pipefail

echo "Checking Linux cross-build prerequisites"
if ! command -v x86_64-w64-mingw32-gcc >/dev/null; then
    sudo apt-get update -qq
    sudo apt-get install -y -qq gcc-mingw-w64-x86-64-posix
fi

export PATH="$HOME/.cargo/bin:$PATH"
if ! command -v rustup >/dev/null; then
    echo "Installing Rust"
    installer="$(mktemp)"
    trap 'rm -f "$installer"' EXIT
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o "$installer"
    sh "$installer" -y --profile minimal --default-toolchain stable
fi

echo "Preparing Rust targets and dependencies"
rustup component add clippy rustfmt
rustup target add x86_64-pc-windows-gnu
cargo fetch --locked --target x86_64-unknown-linux-gnu --target x86_64-pc-windows-gnu
echo "Ready: cargo test --locked; cargo build --release --locked --target x86_64-pc-windows-gnu"
